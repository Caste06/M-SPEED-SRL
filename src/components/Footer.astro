<!-- FOOTER -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="M-SPEED SRL" class="logo-img" style="height:32px;" />
        <p>
          Trasporti internazionali via terra tra Italia ed Europa. Specializzazione nella movimentazione di merce pallettizzata e colli sfusi con un referente diretto dedicato per ogni spedizione.
        </p>
        <div style="margin-top:14px; font-size:12px; font-weight:700; color:var(--color-primary); display:flex; align-items:center; gap:6px;">
          <span class="tricolore-flag-mini" style="width:16px; height:11px;"><span class="band-green"></span><span class="band-white"></span><span class="band-red"></span></span>
          <span>From Italy to Europe.</span>
        </div>
      </div>

      <div>
        <div class="footer-title">Centri Operativi</div>
        <div class="footer-hub-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <div>
            <div class="footer-hub-name">Montecosaro</div>
