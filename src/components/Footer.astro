          <div>
            <div class="footer-hub-name">Fucecchio</div>
            <div class="footer-hub-sub">Toscana (FI) · 0571 35457</div>
          </div>
        </div>
      </div>

      <div>
        <div class="footer-title">Destinazioni Chiave</div>
        <div class="footer-links">
          <a href="/destinazioni/#belgio-lussemburgo">Belgio e Lussemburgo (Settimanale)</a>
          <a href="/destinazioni/#olanda">Olanda (Settimanale)</a>
          <a href="/destinazioni/#germania">Germania (Settimanale)</a>
          <a href="/destinazioni/#francia">Francia (Settimanale)</a>
