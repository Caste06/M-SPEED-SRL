---
export interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
---
<!-- SITE HEADER -->
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="M-SPEED SRL - Torna alla Home">
      <img src="/images/logo.png" alt="M-SPEED SRL" class="logo-img" />
    </a>

    <!-- Desktop Nav -->
    <nav class="nav-desktop" aria-label="Navigazione principale">
      <a href="/" class={`nav-link ${activePage === 'home' ? 'active' : ''}`}>Home</a>
      <a href="/azienda/" class={`nav-link ${activePage === 'azienda' ? 'active' : ''}`}>Azienda</a>
      <a href="/servizi/" class={`nav-link ${activePage === 'servizi' ? 'active' : ''}`}>Servizi</a>
      <a href="/destinazioni/" class={`nav-link ${activePage === 'destinazioni' ? 'active' : ''}`}>Destinazioni</a>
      <a href="/articoli/" class={`nav-link ${activePage === 'articoli' ? 'active' : ''}`}>Articoli</a>
      <a href="/notizie/" class={`nav-link ${activePage === 'notizie' ? 'active' : ''}`}>Notizie</a>
      <a href="/contatti/" class={`nav-link ${activePage === 'contatti' ? 'active' : ''}`}>Contatti</a>
    </nav>

    <!-- Header CTAs -->
    <div class="header-actions">
      <div class="header-phones-group">
        <a href="tel:0733865651" class="header-phone" title="Montecosaro (MC)">
          <div class="header-phone-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="header-phone-hub">
            <span class="hub-label">Montecosaro</span>
            <span class="hub-num">0733 865651</span>
          </div>
        </a>
        <a href="tel:057135457" class="header-phone" title="Fucecchio (FI)">
          <div class="header-phone-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="header-phone-hub">
            <span class="hub-label">Fucecchio</span>
            <span class="hub-num">0571 35457</span>
          </div>
        </a>
      </div>
      <a href="/contatti/" class="btn btn-primary btn-sm">
        <span>Contatti</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <button id="mobile-menu-toggle" class="mobile-toggle-btn" aria-label="Apri menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>
