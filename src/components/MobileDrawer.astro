---
export interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
---
<!-- MOBILE DRAWER -->
<div id="drawer-overlay" class="drawer-overlay"></div>
<div id="mobile-drawer" class="mobile-drawer">
  <div>
    <div class="mobile-drawer-header">
      <img src="/images/logo.png" alt="M-SPEED SRL" class="logo-img" style="height:30px;" />
      <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Chiudi menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <nav class="drawer-nav">
      <a href="/" class={`drawer-link ${activePage === 'home' ? 'active' : ''}`}>Home</a>
      <a href="/azienda/" class={`drawer-link ${activePage === 'azienda' ? 'active' : ''}`}>Azienda</a>
      <a href="/servizi/" class={`drawer-link ${activePage === 'servizi' ? 'active' : ''}`}>Servizi</a>
      <a href="/destinazioni/" class={`drawer-link ${activePage === 'destinazioni' ? 'active' : ''}`}>Destinazioni</a>
      <a href="/articoli/" class={`drawer-link ${activePage === 'articoli' ? 'active' : ''}`}>Articoli</a>
      <a href="/notizie/" class={`drawer-link ${activePage === 'notizie' ? 'active' : ''}`}>Notizie</a>
      <a href="/contatti/" class={`drawer-link ${activePage === 'contatti' ? 'active' : ''}`}>Contatti</a>
    </nav>
  </div>
  <div style="padding-top: 20px; border-top: 1px solid var(--color-border); display:flex; flex-direction:column; gap:10px;">
    <a href="tel:0733865651" class="btn btn-secondary" style="width: 100%;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span>Montecosaro: 0733 865651</span>
    </a>
    <a href="tel:057135457" class="btn btn-secondary" style="width: 100%;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span>Fucecchio: 0571 35457</span>
    </a>
    <a href="/contatti/" class="btn btn-primary" style="width: 100%;">Contatta l'ufficio</a>
  </div>
</div>
