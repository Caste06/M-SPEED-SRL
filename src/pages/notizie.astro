---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articoli');
const articles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}

const notizieSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Notizie e Comunicazioni Clienti | M-SPEED SRL",
  "publisher": {
    "@type": "LogisticsService",
    "name": "M-SPEED SRL",
    "telephone": "+390733865651",
    "email": "sales@m-speed.eu"
  }
};
---

<Layout
  title="Notizie e Avvisi per i Clienti | M-SPEED SRL"
  description="Notizie, comunicazioni operative, aggiornamenti sulle tratte settimanali (Belgio e Lussemburgo, Olanda, Germania, Francia, Spagna, Romania) e consigli logistici per i clienti di M-SPEED SRL."
  keywords="notizie trasporti internazionali, avvisi operativi logistica, partenze settimanali europa, trasporti belgio lussemburgo, trasporti olanda, M-SPEED SRL"
  activePage="notizie"
  schemaJson={notizieSchema}
>
  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span class="breadcrumb-current">Notizie e Avvisi Clienti</span>
      </nav>

      <div class="eyebrow">Comunicazioni &amp; Aggiornamenti Operativi</div>
      <h1 class="page-title">Notizie per i clienti e approfondimenti logistici.</h1>
      <p class="page-desc">
        Una bacheca dedicata alle aziende che spediscono con M-SPEED SRL: novità sulle direttrici europee, programmazioni settimanali di partenza dagli hub di Montecosaro e Fucecchio e consigli utili per la gestione dei carichi.
      </p>
    </div>
  </div>

  <!-- MAIN NEWS & BLOG SECTION -->
  <section class="section section-white">
    <div class="container">
      <!-- FILTER BAR -->
      <div class="news-filter-bar">
        <div class="news-filter-group" role="tablist" aria-label="Filtra notizie per categoria">
          <button type="button" class="news-filter-btn active" data-filter="all">Tutte le comunicazioni</button>
        </div>
        <div id="news-count-label" style="font-size:13px; font-weight:600; color:var(--color-text-muted);">
          {articles.length} {articles.length === 1 ? 'comunicazione pubblicata' : 'comunicazioni pubblicate'}
        </div>
      </div>

      <!-- ARTICLES GRID -->
      <div id="news-grid" class="cards-grid-3">
        {articles.map((article, index) => (
          <article class={`news-card reveal reveal-delay-${(index % 3) + 1}`} data-category="tratte">
            <div>
              <div class="news-card-thumb">
                <a href={`/articoli/${article.id}/`} aria-label={article.data.title}>
                  <img
                    src={article.data.image || '/images/hero-truck-daylight.jpg'}
                    alt={article.data.title}
                  />
                </a>
              </div>
              <div class="news-card-body">
                <div class="news-meta-row">
                  <span class="news-category-badge">{article.data.category || 'Comunicazione'}</span>
                  <span class="news-date">{formatDate(article.data.date)}</span>
                </div>
                <h3 class="news-card-title">
                  <a href={`/articoli/${article.id}/`} style="color:inherit; text-decoration:none;">
                    {article.data.title}
                  </a>
                </h3>
                <p class="news-card-excerpt">
                  {article.data.description}
                </p>
              </div>
            </div>
            <div class="news-card-footer">
              <span style="font-size:12px; color:var(--color-text-muted);">
                {article.data.author || 'M-SPEED SRL'}
              </span>
              <a href={`/articoli/${article.id}/`} class="news-read-btn">
                <span>Leggi comunicazione</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATTO DIRETTO INFO BOX -->
  <section class="section section-slate">
    <div class="container">
      <div class="card" style="padding: 36px;">
        <div class="split-layout" style="align-items:center; gap:32px;">
          <div>
            <div class="eyebrow" style="margin-bottom:6px;">Filo Diretto con l'Operatore</div>
            <h2 style="font-size:24px; font-weight:800; color:var(--color-text-main); margin-bottom:10px;">
              Hai bisogno di chiarimenti operativi su una partenza?
            </h2>
            <p style="font-size:15px; color:var(--color-text-body); line-height:1.65; margin-bottom:0;">
              Il nostro modello di lavoro esclude risposte automatiche o attese ai centralini: contattando le sedi di <strong>Montecosaro</strong> o <strong>Fucecchio</strong> parli direttamente con il referente che segue la programmazione dei camion e le finestre di carico settimanali.
            </p>
          </div>
          <div style="display:flex; flex-direction:column; gap:12px;">
            <a href="tel:0733865651" class="btn btn-secondary" style="justify-content:space-between; width:100%;">
              <span><strong>Sede Montecosaro (MC):</strong> 0733 865651</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </a>
            <a href="tel:057135457" class="btn btn-secondary" style="justify-content:space-between; width:100%;">
              <span><strong>Sede Fucecchio (FI):</strong> 0571 35457</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </a>
            <a href="mailto:sales@m-speed.eu" class="btn btn-primary" style="justify-content:center; width:100%;">
              <span>Scrivi a sales@m-speed.eu</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <CtaSection />
</Layout>
