---
import Layout from '../layouts/Layout.astro';

const contattiSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contatti M-SPEED SRL",
  "url": "https://www.m-speed.eu/contatti/",
  "mainEntity": {
    "@type": "Organization",
    "name": "M-SPEED SRL",
    "telephone": "+390733865651",
    "email": "sales@m-speed.eu"
  }
};
---

<Layout
  title="Contatti | Ufficio Commerciale M-SPEED SRL"
  description="Contatti diretti dell'ufficio commerciale M-SPEED SRL. Telefono: 0733 865651, email: sales@m-speed.eu. Sedi operative a Montecosaro (MC) e Fucecchio (FI)."
  keywords="contatti M-SPEED, telefono M-SPEED, email trasporti, preventivo trasporti internazionali, autotrasporti Montecosaro, logistica Fucecchio"
  activePage="contatti"
  schemaJson={contattiSchema}
>
  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span class="breadcrumb-current">Contatti</span>
      </nav>

      <div class="eyebrow">Ufficio Commerciale M-SPEED</div>
      <h1 class="page-title">Contatti diretti. Senza intermediari.</h1>
      <p class="page-desc">
        Per qualsiasi informazione sui trasporti internazionali o per concordare una spedizione, i nostri uffici commerciali di Montecosaro e Fucecchio sono a disposizione con un referente dedicato.
      </p>
    </div>
  </div>

  <!-- MAIN CONTACT SHOWCASE -->
  <section class="section section-white">
    <div class="container" style="max-width: 1080px;">
      <!-- Three Primary Action Cards (Montecosaro, Fucecchio, Email) -->
      <div class="cards-grid-3" style="margin-bottom: 40px;">
        <!-- Phone Card 1: Montecosaro -->
        <a href="tel:0733865651" class="contact-action-card reveal reveal-delay-1">
          <div>
            <div class="contact-action-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="contact-action-label">Commerciale Montecosaro (MC)</div>
            <div class="contact-action-value">0733 865651</div>
            <p class="contact-action-desc">
              Presidio Marche e Centro Italia. Verifica disponibilità di carico, tratte e partenze settimanali verso l'Europa.
            </p>
          </div>
          <div class="contact-action-footer">
            <span>Chiama Montecosaro</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </div>
        </a>

        <!-- Phone Card 2: Fucecchio -->
        <a href="tel:057135457" class="contact-action-card reveal reveal-delay-2">
          <div>
            <div class="contact-action-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="contact-action-label">Commerciale Fucecchio (FI)</div>
            <div class="contact-action-value">0571 35457</div>
            <p class="contact-action-desc">
              Polo Toscana e Centro-Nord. Contatto diretto per consolidamento merci e rotte transfrontaliere continuative.
            </p>
          </div>
          <div class="contact-action-footer">
            <span>Chiama Fucecchio</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </div>
        </a>

        <!-- Email Card -->
        <a href="mailto:sales@m-speed.eu" class="contact-action-card reveal reveal-delay-3">
          <div>
            <div class="contact-action-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contact-action-label">Email Commerciale</div>
            <div class="contact-action-value email-value">sales@m-speed.eu</div>
            <p class="contact-action-desc">
              Invia una richiesta indicando origine, destinazione, tipologia merce (pallet o colli) e tempi desiderati.
            </p>
          </div>
          <div class="contact-action-footer">
            <span>Scrivi un'email</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </div>
        </a>
      </div>

      <!-- Checklist info for phone/email requests -->
      <div class="card" style="padding: 32px; margin-bottom: 40px;">
        <h3 style="font-size: 20px; font-weight: 800; color: var(--color-text-main); margin-bottom: 6px;">
          Cosa indicare quando richiedi una quotazione
        </h3>
        <p style="font-size: 14px; color: var(--color-text-muted); margin-bottom: 20px;">
          Per consentirci di fornirti rapidamente tempi e costi via telefono o email, ti invitiamo a condividere questi dettagli:
        </p>

        <div class="info-guide-grid">
          <div class="info-guide-item">
            <strong>1. Partenza e Destinazione</strong>
            Comune o CAP di carico in Italia e località di consegna estera.
          </div>
          <div class="info-guide-item">
            <strong>2. Tipologia Merce</strong>
            Bancali (quantità Europallet/pallet standard) o colli sfusi.
          </div>
          <div class="info-guide-item">
            <strong>3. Dimensioni e Ingombro</strong>
            Misure indicative (base × profondità × altezza) della merce.
          </div>
          <div class="info-guide-item">
            <strong>4. Peso Complessivo</strong>
            Peso totale stimato del carico da trasportare.
          </div>
          <div class="info-guide-item">
            <strong>5. Tempistiche Desiderate</strong>
            Data auspicata per il ritiro o finestra utile per la consegna.
          </div>
          <div class="info-guide-item">
            <strong>6. Note di Carico / Scarico</strong>
            Necessità di sponda idraulica, preavviso o vincoli logistici specifici.
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
