---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articoli');
const articles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout
  title="Articoli e Approfondimenti Logistici | M-SPEED SRL"
  description="Guide operative, novità sulle tratte europee e approfondimenti sul trasporto merci pallettizzate e colli industriali a cura di M-SPEED SRL."
  activePage="articoli"
>
  <!-- PAGE HEADER -->
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span class="breadcrumb-current">Articoli</span>
      </nav>

      <div class="eyebrow">Approfondimenti &amp; Logistica Internazionale</div>
      <h1 class="page-title">Articoli, guide operative e novità sui trasporti.</h1>
      <p class="page-desc">
        Uno spazio informativo dedicato alle imprese che spediscono in Europa: consigli tecnici per la preparazione dei bancali, approfondimenti sulle normative comunitarie e aggiornamenti sulle direttrici servite dai nostri hub di Montecosaro e Fucecchio.
      </p>
    </div>
  </div>

  <!-- MAIN ARTICLES SECTION -->
  <section class="section section-white">
    <div class="container">
      <div class="news-filter-bar">
        <div class="news-filter-group" role="tablist">
          <button type="button" class="news-filter-btn active">Tutti gli articoli</button>
        </div>
        <div style="font-size:13px; font-weight:600; color:var(--color-text-muted);">
          {articles.length} {articles.length === 1 ? 'articolo pubblicato' : 'articoli pubblicati'}
        </div>
      </div>

      <div class="cards-grid-3">
        {articles.map((article, index) => (
          <article class={`news-card reveal reveal-delay-${(index % 3) + 1}`}>
            <div>
              <div class="news-card-thumb">
                <a href={`/articoli/${article.id}/`} aria-label={article.data.title}>
                  <img
                    src={article.data.image || '/images/hero-truck-daylight.jpg'}
                    alt={article.data.title}
                    loading="lazy"
                  />
                </a>
              </div>
              <div class="news-card-body">
                <div class="news-meta-row">
                  <span class="news-category-badge">{article.data.category || 'Approfondimento'}</span>
                  <time class="news-date" datetime={new Date(article.data.date).toISOString()}>
                    {formatDate(article.data.date)}
                  </time>
                </div>
                <h2 class="news-card-title">
                  <a href={`/articoli/${article.id}/`} style="color:inherit; text-decoration:none;">
                    {article.data.title}
                  </a>
                </h2>
                <p class="news-card-excerpt">
                  {article.data.description}
                </p>
              </div>
            </div>
            <div class="news-card-footer">
              <span style="font-size:12px; color:var(--color-text-muted);">
                {article.data.author || 'M-SPEED SRL'}
              </span>
              <a href={`/articoli/${article.id}/`} class="news-read-btn">
                <span>Leggi articolo</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <CtaSection />
</Layout>
